# Copy this file to docker/.env and replace all placeholder values before starting services.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_DATABASE=leo
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

REDIS_PASSWORD=replace-with-a-strong-redis-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
