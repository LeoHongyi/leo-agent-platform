# Copy this file to .env and replace placeholder values for your local environment.
APP_NAME=MyApp
APP_ENV=development
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=leo

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-your-redis-password
REDIS_DB=0

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=replace-with-a-fernet-key
PROVIDER_CONNECT_TIMEOUT_SECONDS=10

LOG_LEVEL=DEBUG
LOG_DIR=logs

# MinIO / knowledge-base document processing
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-your-minio-secret
MINIO_BUCKET=knowledge-docs
MINIO_SECURE=false
KNOWLEDGE_MAX_FILE_SIZE_MB=20
KNOWLEDGE_MAX_SEGMENTS=10000
