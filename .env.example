# Copy this file to .env and replace placeholder values for your local environment.
APP_NAME=MyApp
APP_ENV=development
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=leo

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=replace-with-a-fernet-key
PROVIDER_CONNECT_TIMEOUT_SECONDS=10

LOG_LEVEL=DEBUG
LOG_DIR=logs
